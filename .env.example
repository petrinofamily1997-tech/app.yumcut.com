# GitHub Actions secrets / local .env
# Do NOT commit real keys.

# Hosted YumCut API. You can also point this at your own YumCut deployment.
YUMCUT_BASE_URL=https://app.yumcut.com

# Create this in YumCut -> Account -> API keys.
# YumCut User API keys start with ycu_.
YUMCUT_API_KEY=

# Groq API key.
GROQ_API_KEY=

# Optional:
VIDEO_DURATION_SECONDS=60
VIDEO_LANGUAGE=ru
